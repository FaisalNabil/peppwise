---
interface Props {
  active: 'home' | 'features' | 'solutions' | 'pricing' | 'docs' | 'blog' | 'none';
}
const { active } = Astro.props;
const productSection = ['features', 'solutions', 'pricing'].includes(active);
const resourcesSection = ['docs', 'blog'].includes(active);
---
<!-- NAV -->
<nav id="main-nav">
  <a href="/" class="nav-logo">Acme<span>OS</span></a>
  <div class="nav-links">
    <a href="/" class:list={[{ 'nav-active': active === 'home' }]}>Home</a>
    <div class="nav-dropdown">
      <a href="/features" class:list={['nav-dropdown-trigger', { 'nav-active': productSection }]}>Product <span class="dropdown-arrow">▾</span></a>
      <div class="nav-dropdown-menu">
        <a href="/features" class:list={[{ 'active-sub': active === 'features' }]}>Features</a>
        <a href="/solutions" class:list={[{ 'active-sub': active === 'solutions' }]}>Solutions</a>
        <a href="/pricing" class:list={[{ 'active-sub': active === 'pricing' }]}>Pricing</a>
      </div>
    </div>
    <div class="nav-dropdown">
      <a href="/docs" class:list={['nav-dropdown-trigger', { 'nav-active': resourcesSection }]}>Resources <span class="dropdown-arrow">▾</span></a>
      <div class="nav-dropdown-menu">
        <a href="/docs" class:list={[{ 'active-sub': active === 'docs' }]}>Docs &amp; FAQ</a>
        <a href="/blog" class:list={[{ 'active-sub': active === 'blog' }]}>Blog</a>
      </div>
    </div>
    <a href="#contact" class="nav-cta">Get in Touch</a>
  </div>
  <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="nav-mobile-overlay" id="nav-mobile-overlay">
  <a href="/" class="mobile-nav-link">Home</a>
  <a href="/features" class="mobile-nav-link">Features</a>
  <a href="/solutions" class="mobile-nav-link">Solutions</a>
  <a href="/pricing" class="mobile-nav-link">Pricing</a>
  <a href="/docs" class="mobile-nav-link">Docs &amp; FAQ</a>
  <a href="/blog" class="mobile-nav-link">Blog</a>
  <a href="#contact" class="mobile-nav-link">Get in Touch</a>
</div>
