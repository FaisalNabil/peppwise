---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://acmeos-demo.example/#org",
      "name": "AcmeOS",
      "url": "https://acmeos-demo.example",
      "logo": "https://acmeos-demo.example/favicon.svg",
      "email": "hello@acmeos.example",
      "description": "Real-time workflow platform for modern teams — task boards, automations, integrations, and enterprise-grade SSO/SCIM.",
      "areaServed": "Worldwide"
    },
    {
      "@type": "WebSite",
      "@id": "https://acmeos-demo.example/#site",
      "url": "https://acmeos-demo.example",
      "name": "AcmeOS",
      "publisher": {"@id":"https://acmeos-demo.example/#org"}
    },
    {
      "@type": "Service",
      "name": "AcmeOS Workflow Engine",
      "provider": {"@id":"https://acmeos-demo.example/#org"},
      "description": "Task status automation, custom fields, and a realtime collaboration layer built on WebSockets.",
      "serviceType": "Workflow & Collaboration Platform",
      "url": "https://acmeos-demo.example/features"
    },
    {
      "@type": "Service",
      "name": "AcmeOS Enterprise Solutions",
      "provider": {"@id":"https://acmeos-demo.example/#org"},
      "description": "Full integration API, a managed enterprise rollout playbook, and automation tooling for teams migrating off legacy tools.",
      "serviceType": "SaaS Integration & Onboarding",
      "url": "https://acmeos-demo.example/solutions"
    },
    {
      "@type": "Service",
      "name": "AcmeOS Plans & Pricing",
      "provider": {"@id":"https://acmeos-demo.example/#org"},
      "description": "Seat-based pricing from Free through Enterprise, plus Nonprofit, Startup, and Education discount programs.",
      "serviceType": "SaaS Subscription",
      "url": "https://acmeos-demo.example/pricing"
    },
    {"@type":"SiteNavigationElement","name":"Features","url":"https://acmeos-demo.example/features"},
    {"@type":"SiteNavigationElement","name":"Solutions","url":"https://acmeos-demo.example/solutions"},
    {"@type":"SiteNavigationElement","name":"Pricing","url":"https://acmeos-demo.example/pricing"},
    {"@type":"SiteNavigationElement","name":"Docs & FAQ","url":"https://acmeos-demo.example/docs"},
    {"@type":"SiteNavigationElement","name":"Blog","url":"https://acmeos-demo.example/blog"}
  ]
};
---
<BaseLayout
  title="AcmeOS — Real-Time Workflow Platform for Modern Teams"
  description="AcmeOS is a real-time workflow platform: task boards, status automations, webhooks and integrations, and enterprise SSO/SCIM — built, not just announced."
  ogDescription="Task boards, automations, and realtime collaboration for modern teams. Built, not just announced."
  path=""
  active="home"
  jsonLd={jsonLd}
>
<style is:inline slot="head">

/* ─── HERO — DESKTOP ─── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  padding-top: 58px; /* fixed nav */
}
.hero-desk {
  flex: 1;
  position: relative;
  min-height: 620px;
}
.hero-desk .desktop-icons {
  position: absolute;
  left: 1.6rem; top: 2rem;
  z-index: 5;
}
.hero-window { position: absolute; }
#win-welcome {
  left: clamp(130px, 12vw, 200px);
  top: 7%;
  width: min(620px, 56vw);
  z-index: 10;
}
#win-coverage {
  right: 3%;
  top: 42%;
  width: min(420px, 36vw);
  z-index: 11;
}
.os-draggable .os-titlebar { cursor: grab; }
.os-draggable .os-titlebar:active { cursor: grabbing; }

.hero-tag {
  font-family: var(--font-mono);
  font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase;
  font-weight: 700; color: var(--pep-accent);
  margin-bottom: 1.2rem;
}
.hero-tag::before { content: '> '; }
.hero h1 {
  font-family: var(--font-head);
  font-size: clamp(1.9rem, 3.4vw, 3rem);
  font-weight: 700; line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  margin-bottom: 1.2rem;
}
.hero h1 em {
  font-style: normal; color: var(--pep-accent);
  text-decoration: underline wavy var(--pep-accent) 2px;
  text-underline-offset: 7px;
}
.hero-sub {
  font-size: 0.93rem; line-height: 1.75;
  color: var(--text-muted); max-width: 50ch;
  margin-bottom: 1.5rem;
}
.hero-stats {
  display: flex; gap: 1.6rem; flex-wrap: wrap;
  margin-bottom: 1.8rem;
}
.hero-stat-inline { display: flex; flex-direction: column; }
.hero-stat-inline .num {
  font-family: var(--font-head);
  font-size: 1.5rem; font-weight: 700; line-height: 1;
  color: var(--pep-accent);
}
.hero-stat-inline .lbl {
  font-family: var(--font-mono);
  font-size: 0.56rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--text-muted); margin-top: 0.3rem;
}
.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

/* coverage window */
.coverage-rows { display: flex; flex-direction: column; }
.coverage-row {
  display: flex; align-items: center; gap: 0.8rem;
  padding: 0.7rem 0.2rem;
  text-decoration: none;
  border-bottom: 1.5px solid var(--border);
}
.coverage-row:last-child { border-bottom: none; }
.coverage-row:hover { background: var(--bg-2); }
.cov-track {
  font-family: var(--font-mono);
  font-size: 0.58rem; font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase;
  width: 86px; flex-shrink: 0;
}
.cov-track-pep { color: var(--pep-accent); }
.cov-track-dc  { color: var(--einv-accent); }
.cov-name {
  font-size: 0.82rem; font-weight: 600; color: var(--text-primary);
  flex: 1; line-height: 1.3;
}
.cov-status {
  font-family: var(--font-mono);
  font-size: 0.56rem; font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.18rem 0.5rem; border-radius: 3px;
  border: 1.5px solid var(--border-strong);
  flex-shrink: 0;
}
.cov-live     { background: var(--yellow); color: var(--text-primary); }
.cov-upcoming { background: var(--surface); color: var(--text-primary); }

/* taskbar */
.hero-taskbar { position: relative; z-index: 20; }
.taskbar-cta { margin-left: 0.6rem; }

/* ─── OFFERING MATRIX ─── */
.matrix-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1.8rem; margin-top: 3rem;
  align-items: stretch;
}
.matrix-grid .os-window { display: flex; flex-direction: column; }
.matrix-grid .os-body { flex: 1; display: flex; flex-direction: column; }
.mx-model {
  font-family: var(--font-mono);
  font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; margin-bottom: 0.6rem;
}
.mx-model-pep { color: var(--pep-accent); }
.mx-model-dc  { color: var(--einv-accent); }
.matrix-grid h3 { margin-bottom: 0.6rem; font-size: 1.2rem; }
.mx-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1rem; }
.mx-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.2rem; flex: 1; }
.mx-list li {
  font-size: 0.8rem; color: var(--text-muted);
  display: flex; gap: 0.5rem; align-items: flex-start; line-height: 1.5;
}
.mx-list li::before { content: '→'; font-family: var(--font-mono); flex-shrink: 0; }
.mx-list li strong { color: var(--text-primary); }
.mx-links { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.mx-link {
  font-family: var(--font-mono);
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.05em;
  text-transform: uppercase; text-decoration: none;
  padding: 0.4rem 0.85rem; border-radius: 4px;
  border: 1.5px solid var(--border-strong);
  background: var(--surface); color: var(--text-primary);
  box-shadow: var(--shadow-sm);
  transition: transform 0.12s, box-shadow 0.12s;
}
.mx-link:hover { transform: translate(-1px,-1px); box-shadow: 3px 3px 0 #151515; }
.mx-link-pep { background: var(--pep-accent); color: #fff; }
.mx-link-dc  { background: var(--einv-accent); color: #fff; }

/* ─── CREDIBILITY ─── */
.cred-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 4rem; align-items: start;
}
.cred-body {
  font-size: 0.95rem; line-height: 1.85;
  color: var(--text-body); margin-top: 1.2rem;
}
.cred-body strong { color: var(--text-primary); }

.proof-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.proof-list { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }
.proof-list li {
  font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;
  display: flex; align-items: flex-start; gap: 0.5rem;
}
.proof-list li::before { content: '✓'; font-family: var(--font-mono); font-size: 0.7rem; flex-shrink: 0; margin-top: 1px; }
.proof-pep .proof-list li::before { color: var(--pep-accent); }
.proof-dc  .proof-list li::before { color: var(--einv-accent); }
.proof-grid .os-body { padding: 1.3rem 1.4rem; }

/* ─── ROADMAP ─── */
.roadmap-nodes {
  display: grid; grid-template-columns: repeat(6, 1fr);
  gap: 0; position: relative; margin-top: 3.5rem;
}
.roadmap-nodes::before {
  content: '';
  position: absolute;
  top: 9px; left: 7%; right: 7%;
  height: 1.5px;
  background: var(--border-strong);
  opacity: 0.25;
}
.rm-node { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 0.5rem; }
.rm-dot {
  width: 18px; height: 18px; border-radius: 3px; border: 1.5px solid var(--border-strong);
  background: var(--surface); flex-shrink: 0; margin-bottom: 1rem;
  position: relative; z-index: 2;
}
.rm-dot.filled-blue  { background: var(--einv-accent); }
.rm-dot.filled-amber { background: var(--pep-accent); }
.rm-dot.upcoming     { background: var(--yellow); }
.rm-tag {
  font-family: var(--font-mono);
  font-size: 0.53rem; letter-spacing: 0.08em; text-transform: uppercase;
  font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 3px; margin-bottom: 0.4rem;
  border: 1.5px solid var(--border-strong);
}
.rm-tag-blue  { background: var(--einv-pale); color: var(--einv-accent); }
.rm-tag-amber { background: var(--pep-pale);  color: var(--pep-accent); }
.rm-date { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.25rem; }
.rm-date-blue  { color: var(--einv-accent); }
.rm-date-amber { color: var(--pep-accent); }
.rm-label { font-size: 0.76rem; font-weight: 700; color: var(--text-primary); line-height: 1.3; }
.rm-sub { font-weight: 400; color: var(--text-muted); font-size: 0.7rem; }

/* ─── GETTING STARTED ─── */
.engage-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1.8rem; margin-top: 3rem;
}
.engage-grid .os-window { position: relative; }
.engage-grid h3 { margin-bottom: 0.6rem; font-size: 1.2rem; }
.engage-grid p { font-size: 0.86rem; color: var(--text-muted); line-height: 1.7; }
.engage-badge {
  font-family: var(--font-mono);
  font-size: 0.52rem; letter-spacing: 0.1em; text-transform: uppercase;
  font-weight: 700; padding: 0.18rem 0.55rem;
  background: var(--yellow); color: var(--text-primary);
  border: 1.5px solid var(--border-strong); border-radius: 3px;
  flex-shrink: 0;
}

/* ─── CONTACT ─── */
.contact-section {
  text-align: center; padding: 6rem 3rem;
  border-top: 1.5px solid var(--border-strong);
}
.contact-email {
  font-family: var(--font-mono); font-size: 1.15rem; font-weight: 500;
  color: var(--pep-accent); text-decoration: none;
  border-bottom: 2px solid var(--pep-border); padding-bottom: 2px;
  display: inline-block; margin: 1rem 0 2.5rem;
  transition: border-color 0.2s;
}
.contact-email:hover { border-color: var(--pep-accent); }
.contact-btns { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1100px) {
  #win-welcome { width: min(560px, 58vw); left: 130px; }
  #win-coverage { width: min(400px, 40vw); top: 48%; }
}
@media (max-width: 1024px) {
  .proof-grid { grid-template-columns: 1fr; }
  .matrix-grid { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  .hero { min-height: 0; }
  .hero-desk { min-height: 0; padding: 1.5rem 1.5rem 2rem; }
  .hero-desk .desktop-icons {
    position: static;
    flex-direction: row; flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .desktop-icon { width: 84px; padding: 0.45rem 0.3rem; }
  .hero-window { position: static; width: 100% !important; }
  #win-welcome { margin-bottom: 1.2rem; }
  .os-draggable .os-titlebar { cursor: default; }
  .cred-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .proof-grid { grid-template-columns: 1fr 1fr; }
  .engage-grid { grid-template-columns: 1fr; }
  .contact-section { padding: 4.5rem 1.5rem; }
  .contact-btns { flex-direction: column; align-items: center; }
  .btn, .btn-ghost { width: 100%; max-width: 300px; text-align: center; }
  .roadmap-nodes { display: flex; flex-direction: column; gap: 1.5rem; }
  .roadmap-nodes::before { display: none; }
  .rm-node { flex-direction: row; text-align: left; gap: 1rem; align-items: flex-start; }
  .rm-dot { margin-bottom: 0; margin-top: 2px; }
  .rm-node > div { display: flex; flex-direction: column; align-items: flex-start; }
  .hero-stats { gap: 1.2rem; }
  .taskbar-cta { display: none; }
  .taskbar .taskbar-btn { display: none; }
}
@media (max-width: 640px) {
  .proof-grid { grid-template-columns: 1fr; }
  .hero-btns { flex-direction: column; }
  .hero-btns .btn, .hero-btns .btn-ghost { width: 100%; max-width: none; }
}
</style>

<!-- ═══ HERO — DESKTOP ═══ -->
<section class="hero desktop">
  <div class="hero-desk" id="hero-desk">

    <div class="desktop-icons">
      <a href="/features" class="desktop-icon">
        <span class="di-glyph">💻</span>
        <span class="di-label">Dashboard.exe</span>
      </a>
      <a href="/solutions" class="desktop-icon">
        <span class="di-glyph">⚡</span>
        <span class="di-label">Automations.exe</span>
      </a>
      <a href="/pricing" class="desktop-icon">
        <span class="di-glyph">💳</span>
        <span class="di-label">Pricing.exe</span>
      </a>
      <a href="/docs" class="desktop-icon">
        <span class="di-glyph">📖</span>
        <span class="di-label">Docs.hlp</span>
      </a>
      <a href="/blog" class="desktop-icon">
        <span class="di-glyph">📰</span>
        <span class="di-label">Blog.txt</span>
      </a>
      <a href="#contact" class="desktop-icon">
        <span class="di-glyph">✉️</span>
        <span class="di-label">Contact.eml</span>
      </a>
    </div>

    <div class="os-window os-draggable hero-window" id="win-welcome">
      <div class="os-titlebar">
        <span class="os-title">welcome.exe</span>
        <span class="os-controls" aria-hidden="true">– ▢ ✕</span>
      </div>
      <div class="os-body">
        <div class="hero-tag">Real-Time Workflow Platform</div>
        <h1>
          Real-time workflows.<br>
          Any team. <em>Any scale.</em>
        </h1>
        <p class="hero-sub">
          AcmeOS is a task and automation platform built around a realtime collaboration layer — task boards, status automations, webhooks, and enterprise SSO/SCIM. Built, not just announced.
        </p>
        <div class="hero-stats">
          <div class="hero-stat-inline">
            <span class="num">50K+</span>
            <span class="lbl">Teams Onboard</span>
          </div>
          <div class="hero-stat-inline">
            <span class="num">2×Sync</span>
            <span class="lbl">Realtime · Enterprise SSO</span>
          </div>
          <div class="hero-stat-inline">
            <span class="num">4</span>
            <span class="lbl">Plan Tiers</span>
          </div>
        </div>
        <div class="hero-btns">
          <a href="/features" class="btn btn-amber">Explore Features →</a>
          <a href="/pricing" class="btn-ghost">View Pricing →</a>
        </div>
      </div>
    </div>

    <div class="os-window os-draggable hero-window" id="win-coverage">
      <div class="os-titlebar os-titlebar-red">
        <span class="os-title">platform_status.sys</span>
        <span class="os-controls" aria-hidden="true">– ▢ ✕</span>
      </div>
      <div class="os-body" style="padding: 0.6rem 1.2rem;">
        <div class="coverage-rows">
          <a href="/features" class="coverage-row">
            <span class="cov-track cov-track-pep">Platform</span>
            <span class="cov-name">Core Workflow Engine</span>
            <span class="cov-status cov-live">Live</span>
          </a>
          <a href="/features#realtime" class="coverage-row">
            <span class="cov-track cov-track-pep">Platform</span>
            <span class="cov-name">Realtime Automations</span>
            <span class="cov-status cov-live">Live</span>
          </a>
          <a href="/solutions" class="coverage-row">
            <span class="cov-track cov-track-pep">Platform</span>
            <span class="cov-name">Integrations Directory · 50+</span>
            <span class="cov-status cov-live">Live</span>
          </a>
          <a href="/docs#sso" class="coverage-row">
            <span class="cov-track cov-track-dc">Enterprise</span>
            <span class="cov-name">SSO &amp; SCIM Provisioning</span>
            <span class="cov-status cov-upcoming">Beta</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <div class="taskbar hero-taskbar">
    <a href="#contact" class="taskbar-start">⊞ AcmeOS</a>
    <button class="taskbar-btn tb-active" data-win="win-welcome" type="button">welcome.exe</button>
    <button class="taskbar-btn" data-win="win-coverage" type="button">platform_status.sys</button>
    <span class="taskbar-clock" id="taskbar-clock">--:--</span>
  </div>
</section>

<!-- ═══ OFFERING MATRIX ═══ -->
<div class="section-wrap" id="offer">
  <div class="inner">
    <div class="eyebrow eyebrow-amber reveal">What You Get</div>
    <h2 class="reveal">One platform. <em>Three product areas.</em></h2>
    <p class="lead reveal">Every workspace starts with the same core — the product areas below are what you unlock as your team grows.</p>

    <div class="matrix-grid reveal-group">
      <div class="os-window reveal">
        <div class="os-titlebar os-titlebar-red">
          <span class="os-title">workflow_engine.cfg</span>
          <span class="os-controls" aria-hidden="true">– ▢ ✕</span>
        </div>
        <div class="os-body">
          <div class="mx-model mx-model-pep">Core Product</div>
          <h3>Workflow Engine</h3>
          <p class="mx-desc">Boards, tasks, and a status engine that actually drives work forward — not just a place to park cards.</p>
          <ul class="mx-list">
            <li><strong>Boards</strong> &amp; task status codes</li>
            <li><strong>Custom fields</strong> &amp; saved views</li>
            <li>Comments &amp; file attachments</li>
            <li>Full-text search across everything</li>
          </ul>
          <div class="mx-links">
            <a href="/features" class="mx-link mx-link-pep">How It Works</a>
          </div>
        </div>
      </div>

      <div class="os-window reveal">
        <div class="os-titlebar os-titlebar-red">
          <span class="os-title">automations.cfg</span>
          <span class="os-controls" aria-hidden="true">– ▢ ✕</span>
        </div>
        <div class="os-body">
          <div class="mx-model mx-model-pep">Add-On</div>
          <h3>Automations &amp; Integrations</h3>
          <p class="mx-desc">Trigger-based automations plus a full integrations directory, so AcmeOS fits into whatever your team already uses.</p>
          <ul class="mx-list">
            <li><strong>Webhooks</strong> &amp; scheduled triggers</li>
            <li>50+ integrations directory</li>
            <li>Realtime sync engine</li>
            <li>API keys &amp; rate limits</li>
          </ul>
          <div class="mx-links">
            <a href="/solutions" class="mx-link mx-link-pep">Solutions</a>
            <a href="/docs" class="mx-link">Docs</a>
          </div>
        </div>
      </div>

      <div class="os-window reveal">
        <div class="os-titlebar os-titlebar-blue">
          <span class="os-title">enterprise.cfg</span>
          <span class="os-controls" aria-hidden="true">– ▢ ✕</span>
        </div>
        <div class="os-body">
          <div class="mx-model mx-model-dc">Enterprise</div>
          <h3>Enterprise Controls</h3>
          <p class="mx-desc">SSO, audit logs, and role-based permissions for teams that need IT and security sign-off before rolling out.</p>
          <ul class="mx-list">
            <li><strong>SSO/SCIM</strong> provisioning</li>
            <li>Full audit logging</li>
            <li>Role-based permissions</li>
            <li>Dedicated success manager</li>
          </ul>
          <div class="mx-links">
            <a href="/solutions#reliability" class="mx-link mx-link-dc">Enterprise Solutions</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ CREDIBILITY ═══ -->
<div class="section-wrap alt" id="about">
  <div class="inner">
    <div class="cred-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-amber">About AcmeOS</div>
        <h2>Not just another board.<br><em>Built for how teams actually work.</em></h2>
        <p class="cred-body">
          We built AcmeOS around a simple idea: a task board should do more than sit still. <strong>Realtime sync</strong>, a <strong>status engine</strong> that actually drives automations, and a full <strong>webhook and API layer</strong> — all shipped, not roadmapped.
          <br><br>
