<script is:inline>
  // taskbar clock
  const clockEl = document.getElementById('taskbar-clock');
  function tickClock() {
    const now = new Date();
    const time = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    const date = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    clockEl.textContent = time + ' · ' + date;
  }
  tickClock();
  setInterval(tickClock, 30000);

  // draggable hero windows (desktop only)
  const deskMq = window.matchMedia('(min-width: 900px)');
  let topZ = 30;
  function bringToFront(win) {
    topZ++;
    win.style.zIndex = topZ;
    document.querySelectorAll('.taskbar-btn').forEach(b => {
      b.classList.toggle('tb-active', b.dataset.win === win.id);
    });
  }
  document.querySelectorAll('.os-draggable').forEach(win => {
    win.addEventListener('pointerdown', () => { if (deskMq.matches) bringToFront(win); });
    const bar = win.querySelector('.os-titlebar');
    bar.addEventListener('pointerdown', e => {
      if (!deskMq.matches) return;
      if (e.target.closest('a, button')) return;
      e.preventDefault();
      const desk = document.getElementById('hero-desk').getBoundingClientRect();
      const r = win.getBoundingClientRect();
      const ox = e.clientX - r.left, oy = e.clientY - r.top;
      function move(ev) {
        let x = ev.clientX - desk.left - ox;
        let y = ev.clientY - desk.top - oy;
        x = Math.max(-r.width * 0.4, Math.min(x, desk.width - r.width * 0.25));
        y = Math.max(0, Math.min(y, desk.height - 50));
        win.style.left = x + 'px';
        win.style.top = y + 'px';
        win.style.right = 'auto';
      }
      function up() {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
      }
      document.addEventListener('pointermove', move);
      document.addEventListener('pointerup', up);
    });
  });
  document.querySelectorAll('.taskbar-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const win = document.getElementById(btn.dataset.win);
      if (win) bringToFront(win);
    });
  });
</script>

