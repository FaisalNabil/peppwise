---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "AcmeOS",
      "description": "Real-time workflow platform for teams — task management, automations, and integrations across Free, Pro, Business, and Enterprise plans.",
      "brand": {"@type":"Organization","name":"AcmeOS","url":"https://acmeos-demo.example"},
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": "0",
        "highPrice": "24",
        "offerCount": "4"
      },
      "url": "https://acmeos-demo.example/pricing"
    },
    {
      "@type": "WebPage",
      "url": "https://acmeos-demo.example/pricing",
      "name": "Pricing — Free, Pro, Business, Enterprise | AcmeOS",
      "isPartOf": {"@type":"WebSite","url":"https://acmeos-demo.example"}
    }
  ]
};
---
<BaseLayout
  title="Pricing — Free, Pro, Business, Enterprise | AcmeOS"
  description="Simple seat-based pricing for AcmeOS. Start free, upgrade to Pro or Business as you grow, or talk to us about Enterprise, Nonprofit, Startup, and Education programs."
  ogDescription="Start free, upgrade as you grow. Seat-based pricing plus Nonprofit, Startup, and Education discount programs."
  path="/pricing"
  active="pricing"
  jsonLd={jsonLd}
>
<style is:inline slot="head">

/* ─── PAGE HERO ─── */
.page-hero {
  background-color: var(--pep-pale);
  background-image: radial-gradient(rgba(245,78,0,0.12) 1.5px, transparent 1.5px);
  background-size: 24px 24px;
  border-bottom: 1.5px solid var(--border-strong);
  padding: 9rem 3rem 5rem;
}
.page-hero .inner {
  max-width: 1160px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr auto;
  gap: 3rem; align-items: end;
}
.page-hero h1 {
  font-family: var(--font-head);
  font-size: clamp(2rem, 3.6vw, 3.3rem);
  font-weight: 700; line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--text-primary); margin-bottom: 1rem;
}
.page-hero h1 em {
  font-style: normal; color: var(--pep-accent);
  text-decoration: underline wavy var(--pep-accent) 2px;
  text-underline-offset: 7px;
}
.page-hero-sub {
  font-size: 0.95rem; line-height: 1.75;
  color: var(--text-muted); max-width: 48ch; margin-bottom: 1.5rem;
}
.hero-stats { display: flex; gap: 1rem; flex-wrap: wrap; }
.hero-stat {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; padding: 0.8rem 1.2rem; box-shadow: var(--shadow-sm);
}
.hero-stat-num {
  font-family: var(--font-head);
  font-size: 1.6rem; font-weight: 700; line-height: 1; color: var(--pep-accent);
}
.hero-stat-lbl {
  font-family: var(--font-mono);
  font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--text-muted); margin-top: 0.3rem;
}

/* ─── HOW PRICING WORKS ─── */
.corners-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 0; margin-top: 2.5rem;
  border: 1.5px solid var(--border-strong); border-radius: 6px; overflow: hidden;
  background: var(--surface);
  box-shadow: var(--shadow-md);
}
.corner-card {
  background: var(--surface); padding: 1.5rem;
  border-right: 1.5px solid var(--border-strong); position: relative;
}
.corner-card:last-child { border-right: none; }
.corner-label { font-family: var(--font-head); font-size: 1.8rem; font-weight: 700; color: var(--pep-accent); line-height: 1; margin-bottom: 0.4rem; }
.corner-title { font-family: var(--font-head); font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem; }
.corner-desc { font-size: 0.78rem; color: var(--text-muted); line-height: 1.55; }
.corner-arrow {
  position: absolute; top: 50%; right: -13px;
  width: 26px; height: 26px;
  background: var(--yellow); border: 1.5px solid var(--border-strong); border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono);
  font-size: 0.7rem; font-weight: 700; color: var(--text-primary);
  z-index: 2; transform: translateY(-50%);
}
.corner-card:last-child .corner-arrow { display: none; }
.peppol-explainer { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.2rem; margin-top: 2rem; }
.explainer-item { background: var(--surface); border: 1.5px solid var(--border-strong); border-radius: 6px; padding: 1.2rem; box-shadow: var(--shadow-sm); }
.explainer-item h5 { font-family: var(--font-head); font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.3rem; }
.explainer-item p { font-size: 0.78rem; color: var(--text-muted); line-height: 1.55; }
.explainer-tag {
  font-family: var(--font-mono);
  font-size: 0.55rem; letter-spacing: 0.08em; text-transform: uppercase;
  font-weight: 700; color: var(--pep-accent);
  background: var(--pep-pale); border: 1.5px solid var(--pep-accent);
  padding: 0.15rem 0.5rem; border-radius: 3px;
  display: inline-block; margin-bottom: 0.5rem;
}

/* ─── SELF-SERVE VS ENTERPRISE COMPARE ─── */
.model-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; margin-top: 2.5rem; align-items: stretch; }
.model-compare .os-window { display: flex; flex-direction: column; }
.model-compare .os-body { flex: 1; }
.mc-chain {
  font-family: var(--font-mono);
  font-size: 0.72rem; font-weight: 700;
  color: var(--text-primary);
  background: var(--bg-2);
  border: 1.5px solid var(--border-strong);
  border-radius: 4px;
  padding: 0.6rem 0.8rem;
  margin-bottom: 1rem;
  text-align: center;
  line-height: 1.8;
}
.mc-chain .mc-c5 { color: var(--pep-accent); }
.model-compare h3 { margin-bottom: 0.5rem; font-size: 1.15rem; }
.model-compare .mc-desc { font-size: 0.84rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1rem; }
.mc-list { list-style: none; display: flex; flex-direction: column; gap: 0.45rem; }
.mc-list li {
  font-size: 0.8rem; color: var(--text-muted);
  display: flex; gap: 0.5rem; align-items: flex-start; line-height: 1.5;
}
.mc-list li::before { content: '→'; font-family: var(--font-mono); color: var(--pep-accent); flex-shrink: 0; }
.mc-list li strong { color: var(--text-primary); }
.mc-list li a { color: var(--pep-accent); font-weight: 700; text-decoration: none; }
.mc-list li a:hover { text-decoration: underline wavy var(--pep-accent) 1px; text-underline-offset: 4px; }

/* ─── PLAN GRID ─── */
.country-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 2.5rem; }
.country-card {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; box-shadow: var(--shadow-sm); padding: 1.4rem;
  transition: transform 0.15s, box-shadow 0.15s;
}
.country-card:hover { transform: translate(-1px,-1px); box-shadow: var(--shadow-md); }
.country-card.featured { border-left: 4px solid var(--pep-accent); grid-column: span 2; }
.country-flag { font-size: 1.6rem; margin-bottom: 0.5rem; display: block; }
.country-name { font-family: var(--font-head); font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.2rem; }
.country-auth { font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.6rem; }
.country-status {
  font-family: var(--font-mono);
  font-size: 0.55rem; letter-spacing: 0.06em; text-transform: uppercase;
  font-weight: 700; padding: 0.18rem 0.55rem;
  border: 1.5px solid var(--border-strong);
  border-radius: 3px; display: inline-block; margin-bottom: 0.6rem;
}
.status-live-green { background: #C9F2D8; color: #0B5C2E; }
.status-mandate    { background: var(--yellow); color: var(--text-primary); }
.status-progress   { background: var(--einv-pale); color: var(--einv-accent); }
.status-eval       { background: var(--bg-3); color: var(--text-muted); }
.country-link { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; color: var(--pep-accent); text-decoration: none; display: inline-block; margin-top: 0.6rem; }
.country-link:hover { text-decoration: underline wavy var(--pep-accent) 1px; text-underline-offset: 4px; }
.country-note { font-size: 0.77rem; color: var(--text-muted); line-height: 1.5; }

/* ─── UPGRADE PATH TIMELINE ─── */
.sg-section { border-left: 4px solid var(--pep-accent); padding-left: 2rem; }
.sg-timeline { display: flex; flex-direction: column; gap: 0; margin-top: 1.5rem; }
.sg-tl-item {
  display: grid; grid-template-columns: 8rem 1fr;
  gap: 1.5rem; align-items: start;
  padding-bottom: 1.2rem;
  border-left: 1px solid var(--pep-border);
  margin-left: 0.5rem; padding-left: 1.5rem;
  position: relative;
}
.sg-tl-item::before {
  content: '';
  position: absolute; left: -5px; top: 5px;
  width: 9px; height: 9px; border-radius: 2px;
  background: var(--pep-accent); border: 2px solid var(--surface);
  box-shadow: 0 0 0 2px var(--pep-accent);
}
.sg-tl-item:last-child { border-left: none; }
.sg-date { font-size: 0.75rem; font-weight: 700; color: var(--pep-accent); padding-top: 2px; }
.sg-desc { font-size: 0.86rem; color: var(--text-body); line-height: 1.6; }
.sg-desc strong { color: var(--text-primary); }

/* ─── BILLING LIFECYCLE FLOW ─── */
.corner-flow { display: flex; flex-direction: column; margin-top: 2rem; }
.cf-step { display: grid; grid-template-columns: 3rem 1fr; gap: 1.2rem; align-items: stretch; }
.cf-line { display: flex; flex-direction: column; align-items: center; }
.cf-circle {
  width: 32px; height: 32px; border-radius: 6px;
  border: 1.5px solid var(--border-strong);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono);
  font-size: 0.65rem; font-weight: 700; color: var(--pep-accent);
  background: var(--surface); flex-shrink: 0; position: relative; z-index: 2;
  box-shadow: var(--shadow-sm);
}
.cf-circle.c5 { background: var(--yellow); color: var(--text-primary); }
.cf-connector { flex: 1; width: 1px; background: var(--pep-border); min-height: 1rem; margin: 3px 0; }
.cf-step:last-child .cf-connector { display: none; }
.cf-body { padding-bottom: 1.8rem; }
.cf-badge {
  display: inline-block; font-family: var(--font-mono);
  font-size: 0.55rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  padding: 0.15rem 0.5rem; border-radius: 3px;
  background: var(--pep-pale); color: var(--pep-accent);
  border: 1.5px solid var(--pep-accent); margin-bottom: 0.3rem;
}
.cf-body h4 { font-size: 0.95rem; margin-bottom: 0.4rem; }
.cf-body p  { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; }

/* ─── BILLING QUICK REFERENCE ─── */
.c5-kb {
  background: var(--pep-pale); border: 1.5px solid var(--border-strong);
  border-left: 5px solid var(--pep-accent); border-radius: 6px;
  box-shadow: var(--shadow-md);
  padding: 2rem 2.5rem; margin-top: 2rem;
}
.c5-kb-title { font-family: var(--font-head); font-size: 1.2rem; font-weight: 700; color: var(--pep-accent); margin-bottom: 1.5rem; }
.c5-kb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
.c5-kb-item h5 { font-size: 0.83rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem; }
.c5-kb-item p  { font-size: 0.8rem; color: var(--text-muted); line-height: 1.6; }
.c5-kb-item ul { list-style: none; margin-top: 0.4rem; display: flex; flex-direction: column; gap: 0.3rem; }
.c5-kb-item ul li { font-size: 0.78rem; color: var(--text-muted); display: flex; gap: 0.4rem; align-items: flex-start; }
.c5-kb-item ul li::before { content: '·'; color: var(--pep-accent); font-weight: 700; }
.c5-personal-note {
  font-size: 0.84rem; color: var(--text-body);
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; padding: 1rem 1.2rem;
  font-style: italic; line-height: 1.65;
}
.c5-personal-note strong { color: var(--pep-accent); font-style: normal; }

/* ─── ENTERPRISE PROCUREMENT ─── */
.imda-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 1.5rem; }
.imda-card { background: var(--surface); border: 1.5px solid var(--border-strong); border-radius: 6px; padding: 1.4rem; box-shadow: var(--shadow-sm); }
.imda-card h5 { font-family: var(--font-head); font-size: 0.88rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem; }
.imda-card p  { font-size: 0.8rem; color: var(--text-muted); line-height: 1.6; }

/* ─── SELF-SERVE VS ENTERPRISE CHECKLIST ─── */
.crossborder-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; margin-top: 2rem; }
.cb-col h4 { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.8rem; }
.cb-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
.cb-col ul li { font-size: 0.86rem; color: var(--text-muted); display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.55; }
.cb-col ul li::before { content: '→'; color: var(--pep-accent); font-weight: 700; flex-shrink: 0; }

/* ─── BILLING INFRASTRUCTURE ─── */
.impl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.5rem; }
.impl-point { display: flex; gap: 1rem; align-items: flex-start; }
.impl-icon {
  width: 38px; height: 38px; border-radius: 6px;
  background: var(--surface); border: 1.5px solid var(--border-strong);
  box-shadow: var(--shadow-sm);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-size: 0.95rem;
}
.impl-text h5 { font-family: var(--font-head); font-size: 0.9rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
.impl-text p  { font-size: 0.8rem; color: var(--text-muted); line-height: 1.55; }

/* ─── ADD-ON SERVICES ─── */
.service-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; margin-top: 0; }
.service-list { list-style: none; display: flex; flex-direction: column; gap: 1.6rem; }
.service-item { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; align-items: start; }
.service-num { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pep-accent); font-weight: 700; padding-top: 0.2rem; }
.service-item h4 { margin-bottom: 0.3rem; }
.service-item p  { font-size: 0.86rem; color: var(--text-muted); line-height: 1.65; }
.deliverables { margin-top: 0.6rem; font-size: 0.78rem; color: var(--text-faint); font-style: italic; }

/* ─── WHICH PLAN FITS YOU ─── */
.for-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
.for-card { background: var(--surface); border: 1.5px solid var(--border-strong); border-radius: 6px; padding: 1.3rem; box-shadow: var(--shadow-sm); }
.for-card h5 { font-family: var(--font-head); font-size: 0.88rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.3rem; }
.for-card p  { font-size: 0.78rem; color: var(--text-muted); line-height: 1.55; }

/* ─── COMPARE FURTHER HUB ─── */
.hub-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; }
.hub-card {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; box-shadow: var(--shadow-sm); padding: 2rem;
  text-decoration: none; display: block;
  border-left: 5px solid var(--pep-accent);
  transition: transform 0.15s, box-shadow 0.15s;
}
.hub-card:hover { box-shadow: var(--shadow-md); transform: translate(-1px,-1px); }
.hub-eyebrow { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--pep-accent); margin-bottom: 0.6rem; }
.hub-card h3 { margin-bottom: 0.5rem; }
.hub-card p { font-size: 0.86rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1rem; }
.hub-link { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pep-accent); display: flex; align-items: center; gap: 0.4rem; }
.hub-link svg { transition: transform 0.2s; }
.hub-card:hover .hub-link svg { transform: translateX(4px); }

/* ─── CONTACT ─── */
.contact-section { text-align: center; padding: 5rem 3rem; border-top: 1.5px solid var(--border-strong); }
.contact-email {
  font-family: var(--font-mono); font-size: 1.15rem; font-weight: 500;
  color: var(--pep-accent); text-decoration: none;
  border-bottom: 2px solid var(--pep-border); padding-bottom: 2px;
  display: inline-block; margin: 1rem 0 2rem; transition: border-color 0.2s;
}
.contact-email:hover { border-color: var(--pep-accent); }
.contact-btns { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .page-hero { padding: 8rem 2rem 4rem; }
  .page-hero .inner { grid-template-columns: 1fr; }
  .country-grid { grid-template-columns: repeat(2, 1fr); }
  .country-card.featured { grid-column: span 1; }
  .corners-grid { grid-template-columns: repeat(2, 1fr); }
  .corner-card:nth-child(2) .corner-arrow { display: none; }
  .c5-kb-grid { grid-template-columns: 1fr; }
  .impl-grid { gap: 1.5rem; }
}
@media (max-width: 900px) {
  .page-hero { padding: 7rem 1.5rem 3.5rem; }
  .country-grid { grid-template-columns: 1fr 1fr; }
  .corners-grid { grid-template-columns: 1fr 1fr; }
  .corner-card:nth-child(2) .corner-arrow,
  .corner-card:nth-child(4) .corner-arrow { display: none; }
  .peppol-explainer { grid-template-columns: 1fr; }
  .crossborder-grid { grid-template-columns: 1fr; }
  .service-grid { grid-template-columns: 1fr; gap: 2rem; }
  .impl-grid { grid-template-columns: 1fr; }
  .imda-grid { grid-template-columns: 1fr; }
  .for-grid { grid-template-columns: 1fr; }
  .hub-grid { grid-template-columns: 1fr; }
  .contact-section { padding: 4rem 1.5rem; }
  .contact-btns { flex-direction: column; align-items: center; }
  .btn, .btn-ghost { width: 100%; max-width: 300px; text-align: center; }
  .sg-tl-item { grid-template-columns: 5.5rem 1fr; }
}
@media (max-width: 640px) {
  .country-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-direction: column; }
  .c5-kb { padding: 1.5rem; }
}
@media (max-width: 900px) {
  .model-compare { grid-template-columns: 1fr; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<div class="page-hero">
  <div class="inner">
    <div>
      <div class="eyebrow eyebrow-amber" style="animation:fadeUp 0.6s ease both;">Pricing · Free to Start · Seat-Based · Nonprofit &amp; Startup Programs</div>
      <h1 style="animation:fadeUp 0.6s ease 0.1s both;">
        Simple pricing.<br>
        Start free.<br>
        <em>Upgrade when you're ready.</em>
      </h1>
      <p class="page-hero-sub" style="animation:fadeUp 0.6s ease 0.2s both;">
        From a solo pilot to a company-wide rollout — one seat-based pricing model, discount programs for Nonprofits, Startups, and Education, and a straightforward path to Enterprise when you need SSO and audit logs.
      </p>
      <div class="hero-stats" style="animation:fadeUp 0.6s ease 0.3s both;">
        <div class="hero-stat">
          <div class="hero-stat-num">$0</div>
          <div class="hero-stat-lbl">Free Forever Plan</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">4</div>
          <div class="hero-stat-lbl">Core Plan Tiers</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">4</div>
          <div class="hero-stat-lbl">Discount Programs</div>
        </div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:0.8rem;animation:fadeUp 0.6s ease 0.35s both;">
      <a href="mailto:hello@acmeos.example" class="btn btn-amber">Start Free →</a>
      <a href="#enterprise" class="btn-ghost" style="text-align:center;">Talk to Sales →</a>
    </div>
  </div>
</div>

<!-- ═══ HOW PRICING WORKS ═══ -->
<div class="section-wrap no-border" id="how-it-works">
  <div class="inner">
    <div class="eyebrow eyebrow-amber reveal">How Pricing Works</div>
    <h2 class="reveal">Seat-Based. <em>No Surprises.</em></h2>
    <p class="lead reveal">AcmeOS bills per active seat, per month or per year. Unlike some tools, you're never charged for automations run or API calls made — the plan tier decides what's unlocked, not how much you use it.</p>

    <div class="corners-grid reveal">
      <div class="corner-card">
        <div class="corner-arrow">→</div>
        <div class="corner-label">1</div>
        <div class="corner-title">Choose a Plan</div>
        <p class="corner-desc">Pick Free, Pro, or Business based on the features your team needs — not a usage estimate.</p>
      </div>
      <div class="corner-card">
        <div class="corner-arrow">→</div>
        <div class="corner-label">2</div>
        <div class="corner-title">Add Seats</div>
        <p class="corner-desc">Invite your team. Seats are prorated automatically if you add people mid-cycle.</p>
