---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "AcmeOS Enterprise Integrations",
      "provider": {"@type":"Organization","name":"AcmeOS","url":"https://acmeos-demo.example"},
      "description": "Full integration API coverage, a managed enterprise rollout playbook, and automation tooling for teams migrating off spreadsheets and legacy tools.",
      "serviceType": "SaaS Integration & Onboarding",
      "url": "https://acmeos-demo.example/solutions"
    },
    {
      "@type": "WebPage",
      "url": "https://acmeos-demo.example/solutions",
      "name": "Solutions — Enterprise Integrations, Rollout Playbook, Automations | AcmeOS",
      "isPartOf": {"@type":"WebSite","url":"https://acmeos-demo.example"}
    }
  ]
};
---
<BaseLayout
  title="Solutions — Enterprise Integrations, Rollout Playbook, Automations | AcmeOS"
  description="Full integration API coverage, a managed enterprise rollout playbook, and automation tooling for teams migrating off spreadsheets and legacy project tools."
  ogDescription="Full integration API, a managed rollout playbook, and automation tooling for teams migrating to AcmeOS. Built for enterprise scale."
  path="/solutions"
  active="solutions"
  jsonLd={jsonLd}
>
<style is:inline slot="head">

/* ─── PAGE HERO ─── */
.page-hero {
  background-color: var(--einv-pale);
  background-image: radial-gradient(rgba(29,74,255,0.12) 1.5px, transparent 1.5px);
  background-size: 24px 24px;
  border-bottom: 1.5px solid var(--border-strong);
  padding: 9rem 3rem 5rem;
}
.page-hero .inner {
  max-width: 1160px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr auto;
  gap: 3rem; align-items: end;
}
.page-hero h1 {
  font-family: var(--font-head);
  font-size: clamp(2rem, 3.6vw, 3.3rem);
  font-weight: 700; line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--text-primary); margin-bottom: 1rem;
}
.page-hero h1 em {
  font-style: normal; color: var(--einv-accent);
  text-decoration: underline wavy var(--einv-accent) 2px;
  text-underline-offset: 7px;
}
.page-hero-sub {
  font-size: 0.95rem; line-height: 1.75;
  color: var(--text-muted); max-width: 48ch; margin-bottom: 1.5rem;
}
.hero-stats { display: flex; gap: 1rem; flex-wrap: wrap; }
.hero-stat {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; padding: 0.8rem 1.2rem; box-shadow: var(--shadow-sm);
}
.hero-stat-num {
  font-family: var(--font-head);
  font-size: 1.6rem; font-weight: 700; line-height: 1; color: var(--einv-accent);
}
.hero-stat-lbl {
  font-family: var(--font-mono);
  font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--text-muted); margin-top: 0.3rem;
}

/* ─── API COVERAGE ─── */
.api-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 1.5px; background: var(--border-strong);
  border: 1.5px solid var(--border-strong); border-radius: 6px; overflow: hidden;
  box-shadow: var(--shadow-md);
  margin-top: 2.5rem;
}
.api-card {
  background: var(--surface); padding: 1.2rem 1.3rem;
  transition: background 0.2s;
}
.api-card:hover { background: var(--einv-pale); }
.api-method {
  font-family: var(--font-mono);
  font-size: 0.55rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  padding: 0.15rem 0.55rem; border-radius: 3px; display: inline-block;
  border: 1.5px solid var(--border-strong);
  margin-bottom: 0.55rem;
}
.method-post { background: #C9F2D8; color: #0B5C2E; }
.method-get  { background: var(--einv-pale); color: var(--einv-accent); }
.method-put  { background: var(--yellow); color: var(--text-primary); }
.api-card h5 { font-family: var(--font-head); font-size: 0.86rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
.api-card code {
  font-size: 0.7rem; color: var(--text-muted);
  font-family: var(--font-mono); line-height: 1.5;
  display: block; word-break: break-all;
}
.api-done {
  display: flex; align-items: center; gap: 0.3rem;
  font-family: var(--font-mono);
  font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  color: #0B5C2E; margin-top: 0.5rem;
}
.api-done::before { content: '✓'; }
.api-callout {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-left: 5px solid var(--einv-accent); border-radius: 6px;
  box-shadow: var(--shadow-sm);
  padding: 1.4rem 1.6rem; margin-top: 1.5rem;
}
.api-callout p { font-size: 0.88rem; color: var(--text-body); line-height: 1.7; }
.api-callout strong { color: var(--text-primary); }

/* ─── PHASE TIMELINE ─── */
.phase-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1.2rem; margin-top: 2.5rem;
}
.phase-card {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; box-shadow: var(--shadow-sm);
  padding: 1.6rem 1.4rem;
  border-top: 4px solid var(--einv-accent);
  transition: transform 0.15s, box-shadow 0.15s;
}
.phase-card:hover { transform: translate(-1px,-1px); box-shadow: var(--shadow-md); }
.phase-status {
  font-family: var(--font-mono);
  font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase;
  font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 3px;
  border: 1.5px solid var(--border-strong);
  display: inline-block; margin-bottom: 0.9rem;
}
.status-live { background: #C9F2D8; color: #0B5C2E; }
.phase-date { font-family: var(--font-head); font-size: 1.25rem; font-weight: 700; color: var(--einv-accent); margin-bottom: 0.3rem; }
.phase-title { font-family: var(--font-head); font-size: 0.92rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem; }
.phase-desc { font-size: 0.82rem; color: var(--text-muted); line-height: 1.55; }

/* ─── AUTOMATION TRIGGER TYPES ─── */
.doctype-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1.2rem; margin-top: 2.5rem;
}
.doctype-card {
  background: var(--surface); border: 1.5px solid var(--border-strong);
  border-radius: 6px; box-shadow: var(--shadow-sm); padding: 1.6rem;
  border-top: 4px solid var(--einv-accent);
  transition: transform 0.15s, box-shadow 0.15s;
}
.doctype-card:hover { transform: translate(-1px,-1px); box-shadow: var(--shadow-md); }
.doctype-num { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--einv-accent); font-weight: 700; margin-bottom: 0.5rem; }
.doctype-card h4 { margin-bottom: 0.4rem; color: var(--einv-accent); }
.doctype-card h4 span { color: var(--text-primary); }
.doctype-when { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.8rem; line-height: 1.5; }
.doctype-who { font-size: 0.7rem; letter-spacing: 0.08em; font-weight: 700; color: var(--text-faint); text-transform: uppercase; }
.doctype-fields { margin-top: 0.6rem; font-size: 0.75rem; color: var(--text-muted); line-height: 1.55; }

/* ─── LIFECYCLE STEPS ─── */
.lifecycle-steps { display: flex; flex-direction: column; margin-top: 2.5rem; }
.lc-step { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1.2rem; align-items: stretch; }
.lc-step-line { display: flex; flex-direction: column; align-items: center; }
.lc-circle {
  width: 30px; height: 30px; border-radius: 6px;
  border: 1.5px solid var(--border-strong);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono);
  font-size: 0.65rem; font-weight: 700; color: var(--einv-accent);
  background: var(--surface); flex-shrink: 0; position: relative; z-index: 2;
  box-shadow: var(--shadow-sm);
}
.lc-connector { flex: 1; width: 1.5px; background: var(--border-strong); opacity: 0.25; min-height: 1rem; margin: 3px 0; }
.lc-step:last-child .lc-connector { display: none; }
.lc-body { padding-bottom: 1.8rem; }
.lc-badge {
  display: inline-block; font-family: var(--font-mono);
  font-size: 0.55rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  padding: 0.15rem 0.5rem; border-radius: 3px;
  background: var(--einv-pale); color: var(--einv-accent);
  border: 1.5px solid var(--einv-accent); margin-bottom: 0.3rem;
}
.lc-body h4 { font-size: 0.95rem; margin-bottom: 0.4rem; }
.lc-body p  { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; }

/* ─── TWO-COL SERVICE GRID ─── */
.service-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 3.5rem; align-items: start; margin-top: 0;
}
.service-list { list-style: none; display: flex; flex-direction: column; gap: 1.6rem; margin-top: 0; }
.service-item { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; align-items: start; }
.service-num {
  font-family: var(--font-mono);
  font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--einv-accent); font-weight: 700; padding-top: 0.2rem;
}
.service-item h4 { margin-bottom: 0.3rem; }
.service-item p  { font-size: 0.86rem; color: var(--text-muted); line-height: 1.65; }
.deliverables { margin-top: 0.6rem; font-size: 0.78rem; color: var(--text-faint); font-style: italic; }

/* ─── PERSONAL EXPERIENCE ─── */
.impl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.5rem; }
.impl-point { display: flex; gap: 1rem; align-items: flex-start; }
.impl-icon {
  width: 38px; height: 38px; border-radius: 6px;
  background: var(--surface); border: 1.5px solid var(--border-strong);
  box-shadow: var(--shadow-sm);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-size: 0.95rem;
}
.impl-text h5 { font-family: var(--font-head); font-size: 0.9rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
.impl-text p  { font-size: 0.8rem; color: var(--text-muted); line-height: 1.55; }

/* ─── CONTACT ─── */
.contact-section { text-align: center; padding: 5rem 3rem; border-top: 1.5px solid var(--border-strong); }
.contact-email {
  font-family: var(--font-mono); font-size: 1.15rem; font-weight: 500;
  color: var(--einv-accent); text-decoration: none;
  border-bottom: 2px solid var(--einv-border); padding-bottom: 2px;
  display: inline-block; margin: 1rem 0 2rem; transition: border-color 0.2s;
}
.contact-email:hover { border-color: var(--einv-accent); }
.contact-btns { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .page-hero { padding: 8rem 2rem 4rem; }
  .page-hero .inner { grid-template-columns: 1fr; }
  .api-grid { grid-template-columns: repeat(2, 1fr); }
  .service-grid { gap: 2.5rem; }
  .impl-grid { gap: 1.5rem; }
}
@media (max-width: 900px) {
  .page-hero { padding: 7rem 1.5rem 3.5rem; }
  .phase-grid { grid-template-columns: 1fr; }
  .api-grid { grid-template-columns: 1fr 1fr; }
  .doctype-grid { grid-template-columns: 1fr 1fr; }
  .service-grid { grid-template-columns: 1fr; gap: 2rem; }
  .impl-grid { grid-template-columns: 1fr; }
  .contact-section { padding: 4rem 1.5rem; }
  .contact-btns { flex-direction: column; align-items: center; }
  .btn, .btn-ghost { width: 100%; max-width: 300px; text-align: center; }
}
@media (max-width: 600px) {
  .api-grid { grid-template-columns: 1fr; }
  .doctype-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-direction: column; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<div class="page-hero">
  <div class="inner">
    <div>
      <div class="eyebrow eyebrow-blue" style="animation:fadeUp 0.6s ease both;">Solutions · Enterprise Rollout · Integrations · Automations</div>
      <h1 style="animation:fadeUp 0.6s ease 0.1s both;">
        Enterprise integrations.<br>
        Fully <em>supported.</em>
      </h1>
      <p class="page-hero-sub" style="animation:fadeUp 0.6s ease 0.2s both;">
        Rolling AcmeOS out past a single team means covering the whole integration surface — not just the happy path. Every endpoint implemented, every rollout phase mapped, tested at real enterprise scale.
      </p>
      <div class="hero-stats" style="animation:fadeUp 0.6s ease 0.3s both;">
        <div class="hero-stat">
          <div class="hero-stat-num">8</div>
          <div class="hero-stat-lbl">Integration Endpoints Covered</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">5</div>
          <div class="hero-stat-lbl">Automation Trigger Types</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">SSO</div>
          <div class="hero-stat-lbl">SAML + SCIM Ready</div>
        </div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:0.8rem;animation:fadeUp 0.6s ease 0.35s both;">
      <a href="#contact" class="btn btn-blue">Book a Rollout Call</a>
      <a href="/features" class="btn-ghost" style="text-align:center;font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:700;">See core features →</a>
    </div>
  </div>
</div>

<!-- ═══ INTEGRATION API COVERAGE ═══ -->
<div class="section-wrap no-border" id="api">
  <div class="inner">
    <div class="eyebrow eyebrow-blue reveal">Integration API Coverage</div>
    <h2 class="reveal">Every Endpoint. <em>Implemented.</em></h2>
    <p class="lead reveal">A real enterprise rollout means more than reading and writing tasks — it means the full integration surface below, ready to plug into your existing stack.</p>

    <div class="api-grid reveal">
      <div class="api-card">
        <span class="api-method method-post">POST</span>
        <h5>Create Task</h5>
        <code>/api/v1.0/tasks</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-get">GET</span>
        <h5>Get Task Status</h5>
        <code>/api/v1.0/tasks/&#123;id&#125;</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-get">GET</span>
        <h5>Get Workspace Details</h5>
        <code>/api/v1.0/workspaces/&#123;id&#125;</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-put">PUT</span>
        <h5>Update Task State</h5>
        <code>/api/v1.0/tasks/&#123;id&#125;/state</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-put">PUT</span>
        <h5>Archive Task</h5>
        <code>/api/v1.0/tasks/&#123;id&#125;/archive</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-get">GET</span>
        <h5>Search Tasks</h5>
        <code>/api/v1.0/tasks/search</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-get">GET</span>
        <h5>Validate Team Member</h5>
        <code>/api/v1.0/members/validate/&#123;email&#125;</code>
        <div class="api-done">Implemented</div>
      </div>
      <div class="api-card">
        <span class="api-method method-post">POST</span>
        <h5>Authentication</h5>
        <code>OAuth 2.0 client credentials token flow</code>
        <div class="api-done">Implemented</div>
      </div>
    </div>

    <div class="api-callout reveal">
      <p><strong>What this means for your team:</strong> If you're building an internal tool, an ERP bridge, or a custom dashboard on top of AcmeOS, this API layer is complete. Task management, real-time status polling, archival, search, member validation, and OAuth token management — all endpoints implemented, tested, and ready to integrate.</p>
      <p style="margin-top:0.8rem;"><strong>SSO on the roadmap for every plan:</strong> SAML-based SSO and SCIM provisioning ship on Enterprise today, with the same identity layer available to Pro workspaces on request. See <a href="/features" style="color:var(--einv-accent);font-weight:700;">Features</a> for the full breakdown.</p>
    </div>
  </div>
</div>

<!-- ═══ ROLLOUT PHASES ═══ -->
<div class="section-wrap alt" id="phases">
  <div class="inner">
    <div class="eyebrow eyebrow-blue reveal">Rollout Playbook</div>
    <h2 class="reveal">Company-Wide Rollout <em>Made Simple</em></h2>
    <p class="lead reveal">Enterprise rollouts succeed when they're staged, not switched on overnight. This is the same three-phase playbook our team uses with every customer moving off spreadsheets or a legacy tool.</p>

    <div class="phase-grid reveal-group">
      <div class="phase-card reveal">
        <span class="phase-status status-live">Phase 1</span>
        <div class="phase-date">Weeks 1–2</div>
        <div class="phase-title">Pilot Team</div>
        <p class="phase-desc">One team migrates their existing workflow into AcmeOS, with a dedicated onboarding session and a direct line to support for fast feedback.</p>
      </div>
      <div class="phase-card reveal">
        <span class="phase-status status-live">Phase 2</span>
        <div class="phase-date">Weeks 3–6</div>
        <div class="phase-title">Department-Wide</div>
        <p class="phase-desc">Once the pilot team's workflows are proven, roll out to the rest of the department with templates and automations already configured.</p>
      </div>
      <div class="phase-card reveal">
        <span class="phase-status status-live">Phase 3</span>
        <div class="phase-date">Weeks 7+</div>
        <div class="phase-title">Company-Wide</div>
        <p class="phase-desc">Full rollout across every team, with SSO enforced, roles finalised, and legacy tools decommissioned on your own timeline.</p>
      </div>
    </div>

    <div style="margin-top:2rem;padding:1.4rem 1.6rem;background:var(--yellow-pale);border:1.5px solid var(--border-strong);border-left:5px solid var(--yellow);border-radius:6px;box-shadow:var(--shadow-sm);" class="reveal">
      <h4 style="margin-bottom:0.5rem;">Why a staged rollout beats a big-bang switch</h4>
      <p style="font-size:0.87rem;color:var(--text-muted);line-height:1.6;">Teams that migrate all at once tend to hit the same friction: half-configured automations, unclear ownership, and a support queue that spikes on day one. Staging the rollout by team keeps automations tested before they're company-wide, and gives your admins time to tune roles and permissions before everyone's watching.</p>
    </div>
  </div>
</div>

<!-- ═══ AUTOMATION TRIGGER TYPES ═══ -->
<div class="section-wrap surface" id="triggers">
  <div class="inner">
    <div class="eyebrow eyebrow-blue reveal">Automation Triggers</div>
    <h2 class="reveal">Five Trigger <em>Types</em></h2>
    <p class="lead reveal">Every automation in AcmeOS starts with one of five trigger types. Each has its own use case, configuration, and ownership model.</p>

    <div class="doctype-grid reveal-group">
      <div class="doctype-card reveal">
        <div class="doctype-num">Type 01</div>
        <h4><span>Scheduled</span></h4>
        <p class="doctype-when">Runs on a fixed cadence — daily standup reminders, weekly reports, monthly billing summaries.</p>
        <div class="doctype-who">Configured by: Admin or Editor</div>
        <div class="doctype-fields">Key fields: Cron expression, timezone, recipient list.</div>
      </div>
      <div class="doctype-card reveal">
        <div class="doctype-num">Type 02</div>
        <h4><span>Event-Based</span></h4>
        <p class="doctype-when">Fires the moment something happens in the workspace — a task moves to Done, a form is submitted.</p>
        <div class="doctype-who">Configured by: Editor</div>
        <div class="doctype-fields">Triggers instantly, no polling delay.</div>
      </div>
      <div class="doctype-card reveal">
        <div class="doctype-num">Type 03</div>
        <h4><span>Conditional</span></h4>
        <p class="doctype-when">Only runs when a field matches a rule — priority is High, or assignee is empty after 24 hours.</p>
        <div class="doctype-who">Configured by: Editor</div>
        <div class="doctype-fields">Supports AND/OR rule chains across any custom field.</div>
      </div>
      <div class="doctype-card reveal">
        <div class="doctype-num">Type 04</div>
        <h4><span>Webhook-Triggered</span></h4>
        <p class="doctype-when">Started by an inbound webhook from an external tool — a form service, a support inbox, a CI pipeline.</p>
        <div class="doctype-who">Configured by: Admin</div>
        <div class="doctype-fields">Requires a signed inbound endpoint URL.</div>
      </div>
      <div class="doctype-card reveal">
        <div class="doctype-num">Type 05</div>
        <h4><span>Manual</span></h4>
        <p class="doctype-when">Triggered on demand by a team member clicking a button — for one-off actions that shouldn't run automatically.</p>
        <div class="doctype-who">Configured by: Any Editor</div>
        <div class="doctype-fields">Optional confirmation step before running.</div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ AUTOMATION LIFECYCLE ═══ -->
<div class="section-wrap alt" id="lifecycle">
  <div class="inner">
    <div class="eyebrow eyebrow-blue reveal">Technical Architecture</div>
    <h2 class="reveal">The Automation <em>Lifecycle</em></h2>
    <p class="lead reveal">Every automation run passes through this five-stage flow. Understanding it makes debugging a stuck automation straightforward.</p>

    <div class="lifecycle-steps">
      <div class="lc-step">
        <div class="lc-step-line">
          <div class="lc-circle">1</div><div class="lc-connector"></div>
        </div>
        <div class="lc-body reveal">
          <h4>Trigger Fires</h4>
          <p>One of the five trigger types activates — a schedule, an event, a condition becoming true, an inbound webhook, or a manual click.</p>
        </div>
      </div>
      <div class="lc-step">
        <div class="lc-step-line">
          <div class="lc-circle">2</div><div class="lc-connector"></div>
        </div>
        <div class="lc-body reveal">
          <span class="lc-badge">Validated</span>
          <h4>Conditions Evaluated</h4>
          <p>Any rule chain attached to the automation is checked. If conditions aren't met, the run stops here and is logged as skipped.</p>
        </div>
      </div>
      <div class="lc-step">
        <div class="lc-step-line">
          <div class="lc-circle">3</div><div class="lc-connector"></div>
        </div>
        <div class="lc-body reveal">
